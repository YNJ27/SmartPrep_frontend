VITE_GOOGLE_API_KEY=
# Google API key, you will get it from AI Studio.

VITE_ROOT_FOLDER_ID=
# Google Drive root folder ID (In between "folder/" and "?resourcekey" in SPPU PYQ Drive link).

VITE_RESOURCE_KEY=
# Google Drive resource key (After "?resourcekey" in SPPU PYQ Drive link)

VITE_API_BASE_URL=
# Base URL for the FastAPI backend; leave empty for same-origin relative URLs.

VITE_SUPABASE_API_KEY=
# Supabase publishable API key for client-side Supabase access.

VITE_SUPABASE_PROJECT_URL=
# Supabase project URL for connecting the frontend to Supabase.
